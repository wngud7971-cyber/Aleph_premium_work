<Window x:Class="Pds.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDS · 하루를 가볍게" Width="940" Height="700" MinWidth="900" MinHeight="620" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="10,7">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal"><TextBlock Text="PDS" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,16,0"/><TextBlock Text="내 하루를 가볍게" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" x:Name="Tagline"/></StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PinButton" Content="고정 꺼짐" Click="Pin_Click" Visibility="Collapsed"/><Button x:Name="ThemeButton" Content="다크 모드" Click="Theme_Click"/><Button Content="설정" Click="Settings_Click"/><Button x:Name="ModeButton" Content="소형 모드" Click="Mode_Click"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" x:Name="Body">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
      <Grid x:Name="CalendarArea" Margin="18,18,18,12" SizeChanged="Calendar_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><TextBlock x:Name="MonthTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="‹" ToolTip="이전 달" Click="Previous_Click"/><Button Content="오늘" Click="Today_Click"/><Button Content="›" ToolTip="다음 달" Click="Next_Click"/></StackPanel></DockPanel>
        <ScrollViewer x:Name="CalendarViewport" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Center">
          <StackPanel HorizontalAlignment="Center"><UniformGrid x:Name="WeekDays" Columns="7" Height="28"/><UniformGrid x:Name="MonthGrid" Columns="7"/></StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="2" x:Name="Summary" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
        <Border Grid.RowSpan="3" x:Name="MeditationCard" Width="420" MinHeight="160" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Accent}" BorderThickness="1,5,1,1" CornerRadius="12" Panel.ZIndex="5" Visibility="Collapsed">
          <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16"/></Border.Effect>
          <Grid Margin="26"><Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-18,-18,0" Padding="7,2" ToolTip="명상 안내 닫기" Click="DismissMeditation_Click"/><StackPanel VerticalAlignment="Center"><TextBlock Text="5분 명상" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="잠시 호흡을 고르고,&#10;차분하게 하루를 시작해 보세요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" LineHeight="23"/></StackPanel></Grid>
        </Border>
      </Grid>
      <Border Grid.Column="1" x:Name="Details" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Padding="16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"><DockPanel><Button DockPanel.Dock="Right" Content="×" ToolTip="상세 닫기" Click="CloseDetails_Click"/><StackPanel><TextBlock Text="선택한 날짜 · 계획" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SelectedTitle" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
            <TextBlock x:Name="EmptyMessage" Text="아직 계획이 없어요." Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
            <StackPanel x:Name="PlanList"/>
            <TextBlock x:Name="EditorTitle" Text="새 계획" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <TextBox x:Name="TitleInput" MaxLength="200" TextChanged="Editor_Changed" AutomationProperties.Name="계획 제목"/>
            <CheckBox x:Name="TimeEnabled" Content="시간 지정 · 선택" Checked="Time_Changed" Unchecked="Time_Changed"/>
            <Grid x:Name="TimeFields" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="StartInput" MaxLength="5" TextChanged="Editor_Changed" ToolTip="시작 시간 · 예: 09:00" AutomationProperties.Name="시작 시간"/><TextBox Grid.Column="2" x:Name="EndInput" MaxLength="5" TextChanged="Editor_Changed" ToolTip="종료 시간 · 예: 10:00" AutomationProperties.Name="종료 시간"/></Grid>
            <TextBlock Text="메모 · 선택" FontSize="12"/><TextBox x:Name="NoteInput" AcceptsReturn="True" TextWrapping="Wrap" Height="82" VerticalScrollBarVisibility="Auto" MaxLength="2000" TextChanged="Editor_Changed" AutomationProperties.Name="계획 메모"/>
            <Button x:Name="CancelEditButton" Content="수정 취소" Click="CancelEdit_Click" Visibility="Collapsed"/>
          </StackPanel></ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12"><DockPanel><Button x:Name="SaveButton" DockPanel.Dock="Right" Content="저장" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Click="Save_Click"/><TextBlock x:Name="SaveStatus" Text="선택한 날짜의 기록" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,7"><DockPanel LastChildFill="False"><TextBlock x:Name="Status" Text="기록을 준비하고 있어요." FontSize="11" Foreground="{DynamicResource Muted}"/><Button DockPanel.Dock="Right" Content="완전히 종료" FontSize="11" Padding="6,1" Margin="0" Click="Exit_Click"/></DockPanel></Border>
  </Grid>
</Window>
