<Window x:Class="Pds.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:Pds.Desktop" Style="{StaticResource {x:Type Window}}" Title="PDS · 하루를 가볍게" Width="900" Height="880" ResizeMode="CanMinimize" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
  <Border Background="{DynamicResource Canvas}" CornerRadius="16" Margin="8">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="TopBar" Margin="20,14,20,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="Brand" Text="PDS." FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="{x:Static ui:UiTypography.Display}" Margin="0,0,20,0" VerticalAlignment="Center"/>
          <Border Background="{DynamicResource Paper}" CornerRadius="20" Padding="3"><StackPanel Orientation="Horizontal">
            <Button Content="캘린더" Background="{DynamicResource Note}" Click="Calendar_Click" Padding="10,5" Margin="0"/>
            <Button Content="통계" Click="Statistics_Click" Padding="10,5" Margin="0"/>
            <Button Content="기념일" Click="Anniversaries_Click" Padding="10,5" Margin="0"/>
            <Button Content="설정" Click="Settings_Click" Padding="10,5" Margin="0"/>
          </StackPanel></Border>
        </StackPanel>
        <WrapPanel x:Name="TopActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ThemeButton" Content="다크 모드" Click="Theme_Click" Padding="10,6"/>
        </WrapPanel>
      </Grid>
      <Grid Grid.Row="1" x:Name="Body">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="0"/></Grid.ColumnDefinitions>
        <Grid x:Name="CalendarArea" Margin="20,10,20,16" SizeChanged="Calendar_SizeChanged">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="MonthHeader" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock x:Name="YearTitle" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><TextBlock x:Name="MonthTitle" FontFamily="{StaticResource DisplayFont}" FontStyle="Italic" FontSize="{x:Static ui:UiTypography.Display}"/><TextBlock x:Name="HolidayCoverage" FontSize="{x:Static ui:UiTypography.Small}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/></StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><Button Content="‹" ToolTip="이전 달" Click="Previous_Click" Padding="9,4"/><Button Content="오늘" Click="Today_Click" Padding="9,4"/><Button Content="›" ToolTip="다음 달" Click="Next_Click" Padding="9,4"/><Button Content="5분 명상" Background="{DynamicResource Note}" Click="Meditation_Click" Padding="10,4"/></WrapPanel>
          </Grid>
          <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border ClipToBounds="True" Height="30"><Canvas><UniformGrid x:Name="WeekDays" Columns="7" Height="30" HorizontalAlignment="Left"/></Canvas></Border>
            <ScrollViewer x:Name="CalendarViewport" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" ScrollChanged="Calendar_ScrollChanged" SizeChanged="Calendar_SizeChanged">
              <UniformGrid x:Name="MonthGrid" Columns="7" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </ScrollViewer>
          </Grid>
          <Border Grid.Row="2" Background="{DynamicResource Paper}" CornerRadius="10" Padding="12,8" Margin="0,12,0,0"><TextBlock x:Name="Summary" Foreground="{DynamicResource Muted}"/></Border>
          <Border Grid.RowSpan="3" x:Name="MeditationCard" Width="420" MinHeight="160" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Accent}" BorderThickness="1,5,1,1" CornerRadius="12" Panel.ZIndex="5" Visibility="Collapsed">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16"/></Border.Effect>
            <Grid Margin="26">
              <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-18,-18,0" Padding="7,2" ToolTip="언제든 닫을 수 있어요" Click="DismissMeditation_Click"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="5분 명상" FontSize="{x:Static ui:UiTypography.Heading}" Margin="0,0,0,10"/>
                <TextBlock x:Name="MeditationMessage" Text="잠시 호흡을 고르고, 차분하게 시작해 보세요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" MinHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                <Grid Margin="0,12,0,0" Height="36">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="MeditationRemaining" Text="05:00" FontFamily="Consolas, Courier New" FontStyle="Normal" FontWeight="Normal" FontSize="{x:Static ui:UiTypography.Timer}" Typography.NumeralAlignment="Tabular" Typography.NumeralStyle="Lining" Width="112" Height="36" LineHeight="36" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left"/>
                  <Button Grid.Column="1" x:Name="MeditationStart" Content="시작" Width="96" Height="36" Margin="0" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Click="StartMeditation_Click" Padding="12,7"/>
                </Grid>
                <TextBlock Text="언제든 닫아도 괜찮아요." Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Border Grid.Column="1" x:Name="Details" Background="{DynamicResource Paper}" CornerRadius="16" Margin="0,0,16,16" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Padding="20,18" Background="{DynamicResource Note}" CornerRadius="16,16,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectedNumber" FontFamily="{StaticResource DisplayFont}" FontSize="{x:Static ui:UiTypography.SelectedDate}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SelectedYear" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="SelectedTitle" Margin="0,4,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="×" ToolTip="상세 닫기" Click="CloseDetails_Click" VerticalAlignment="Top" Padding="4,0" Margin="8,0,0,0" Background="Transparent"/>
              </Grid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource Soft}" CornerRadius="8" Margin="16,14,16,0" Padding="3"><UniformGrid Columns="3"><Button x:Name="PlanTab" Content="계획" Click="PlanTab_Click" Margin="0" Padding="5,7" Background="{DynamicResource Note}"/><Button x:Name="WorkoutTab" Content="운동" Click="WorkoutTab_Click" Margin="0" Padding="5,7" Background="Transparent"/><Button x:Name="ReviewTab" Content="회고" Click="ReviewTab_Click" Margin="0" Padding="5,7" Background="Transparent"/></UniformGrid></Border>
            <ScrollViewer x:Name="PlanPane" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,18,18,4">
              <StackPanel x:Name="HolidayDayList" Margin="0,0,0,8" Visibility="Collapsed"/>
              <StackPanel x:Name="AnniversaryDayList" Margin="0,0,0,12" Visibility="Collapsed"/>
              <Grid Margin="0,0,0,8"><TextBlock Text="오늘의 계획"/><TextBlock x:Name="DailyCount" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid>
              <TextBlock x:Name="EmptyMessage" Text="아직 계획이 없어요." Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
              <TextBlock Text="완료 체크는 선택한 날짜에 실행한 것으로 기록해요. 실제 날짜는 수정에서 바꿀 수 있어요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <StackPanel x:Name="PlanList"/>
              <TextBlock x:Name="EditorTitle" Text="새 계획" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
              <TextBox x:Name="TitleInput" MaxLength="200" TextChanged="Editor_Changed" AutomationProperties.Name="계획 제목"/>
              <CheckBox x:Name="TimeEnabled" Content="시간 지정 · 선택" Checked="Time_Changed" Unchecked="Time_Changed"/>
              <Grid x:Name="TimeFields" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBox x:Name="StartInput" MaxLength="5" TextChanged="Editor_Changed" ToolTip="시작 시간 · 예: 09:00" AutomationProperties.Name="시작 시간"/><TextBox Grid.Column="2" x:Name="EndInput" MaxLength="5" TextChanged="Editor_Changed" ToolTip="종료 시간 · 예: 10:00" AutomationProperties.Name="종료 시간"/></Grid>
              <StackPanel x:Name="ActualDateFields" Visibility="Collapsed"><TextBlock Text="실제 완료 날짜 · 선택" Foreground="{DynamicResource Muted}"/><DatePicker x:Name="ActualDateInput" SelectedDateChanged="ActualDate_Changed" AutomationProperties.Name="계획 실제 완료 날짜"/><TextBlock Text="미입력 기록은 요일별 완료 집계에서 제외돼요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/></StackPanel>
              <TextBlock Text="메모 · 선택" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/><TextBox x:Name="NoteInput" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto" MaxLength="2000" TextChanged="Editor_Changed" AutomationProperties.Name="계획 메모"/>
              <Button x:Name="CancelEditButton" Content="수정 취소" Click="CancelEdit_Click" Visibility="Collapsed"/>
            </StackPanel></ScrollViewer>
            <ScrollViewer x:Name="WorkoutPane" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,18,18,4">
              <Grid Margin="0,0,0,8"><TextBlock Text="오늘의 운동"/><TextBlock x:Name="WorkoutCount" MaxWidth="175" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid>
              <TextBlock x:Name="WorkoutRecordDate" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource Muted}"/>
              <TextBlock x:Name="EmptyWorkoutMessage" Text="아직 운동 기록이 없어요." Foreground="{DynamicResource Muted}" Margin="0,8,0,12"/>
              <StackPanel x:Name="WorkoutList"/>
              <TextBlock x:Name="WorkoutEditorTitle" Text="새 운동" Margin="0,16,0,8" Foreground="{DynamicResource Muted}"/>
              <TextBlock Text="분류" Foreground="{DynamicResource Muted}"/>
              <ComboBox x:Name="WorkoutCategory" SelectionChanged="WorkoutCategory_Changed" AutomationProperties.Name="운동 분류"/>
              <TextBlock Text="세부 종목" Foreground="{DynamicResource Muted}"/>
              <ComboBox x:Name="WorkoutExercise" SelectionChanged="WorkoutExercise_Changed" AutomationProperties.Name="운동 종목"/>
              <StackPanel x:Name="WorkoutQuantityFields" Visibility="Collapsed"><TextBlock x:Name="WorkoutQuantityLabel" Foreground="{DynamicResource Muted}"/><TextBox x:Name="WorkoutQuantity" MaxLength="10" TextChanged="Editor_Changed" AutomationProperties.Name="운동 횟수 또는 층수"/></StackPanel>
              <TextBlock x:Name="WorkoutTimeLabel" Text="운동 시간" Foreground="{DynamicResource Muted}"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBox x:Name="WorkoutMinutes" TextChanged="Editor_Changed" MaxLength="4" AutomationProperties.Name="운동 시간 분"/><TextBlock Grid.Column="1" Text="분" VerticalAlignment="Center" Margin="5,0,0,6"/><TextBox Grid.Column="2" x:Name="WorkoutSeconds" TextChanged="Editor_Changed" MaxLength="2" AutomationProperties.Name="운동 시간 초"/><TextBlock Grid.Column="3" Text="초" VerticalAlignment="Center" Margin="5,0,0,6"/></Grid>
              <TextBlock x:Name="WorkoutInputHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <StackPanel x:Name="FutsalFields" Visibility="Collapsed">
                <TextBlock Text="실제 경기 시간 · 선택" Foreground="{DynamicResource Muted}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBox x:Name="FutsalMinutes" MaxLength="4" TextChanged="EnergyText_Changed" AutomationProperties.Name="풋살 실제 경기 분"/><TextBlock Grid.Column="1" Text="분" VerticalAlignment="Center"/><TextBox Grid.Column="2" x:Name="FutsalSeconds" MaxLength="2" TextChanged="EnergyText_Changed" AutomationProperties.Name="풋살 실제 경기 초"/><TextBlock Grid.Column="3" Text="초" VerticalAlignment="Center"/></Grid>
                <WrapPanel><Button Content="총 2시간" Click="FutsalTwoHours_Click" Padding="9,5"/><TextBox x:Name="FutsalCycles" Width="45" MaxLength="2" Text="6" Margin="3" ToolTip="완료한 20분 주기 횟수"/><Button Content="15+5 제안" Click="FutsalPattern_Click" Padding="9,5"/></WrapPanel>
                <TextBlock Text="15+5는 완료한 주기 수로 시간을 제안해요. 제안값을 적용한 뒤 실제 경기 시간을 확인하세요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,10"/>
              </StackPanel>
              <Border Background="{DynamicResource Soft}" CornerRadius="8" Padding="10" Margin="0,0,0,12"><StackPanel>
                <TextBlock x:Name="WeightStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <Button Content="체중 등록·다시 입력" Click="Weight_Click" Padding="8,5" HorizontalAlignment="Left"/>
                <CheckBox x:Name="EnergyEnabled" Content="예상 kcal 계산 · 선택" Checked="EnergyOption_Changed" Unchecked="EnergyOption_Changed"/>
                <StackPanel x:Name="EnergyFields" Visibility="Collapsed">
                  <CheckBox x:Name="AdultBasis" Content="19~59세 성인 기준 적용 확인" Checked="EnergyOption_Changed" Unchecked="EnergyOption_Changed"/>
                  <TextBlock Text="이 운동의 적용 체중 · kg" Foreground="{DynamicResource Muted}"/>
                  <TextBox x:Name="EnergyWeight" MaxLength="10" TextChanged="EnergyText_Changed" AutomationProperties.Name="운동 계산 체중 kg"/>
                  <Button Content="현재 기본 체중 적용" Click="UseCurrentWeight_Click" Padding="8,5" HorizontalAlignment="Left"/>
                  <TextBlock Text="기록별 체중을 바꿔도 기본 체중 갱신일은 바뀌지 않아요. 과거 운동에는 당시 적용할 값을 확인하세요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                  <CheckBox x:Name="EnergyDetailed" Content="상세 입력" Checked="EnergyOption_Changed" Unchecked="EnergyOption_Changed"/>
                  <ComboBox x:Name="EnergyPresetChoice" SelectionChanged="EnergyPreset_Changed" AutomationProperties.Name="운동 kcal 기준"/>
                  <StackPanel x:Name="EnergyDetailFields" Visibility="Collapsed"><TextBlock x:Name="EnergyDetailLabel" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><TextBox x:Name="EnergyDetailValue" MaxLength="12" TextChanged="EnergyText_Changed" AutomationProperties.Name="kcal 상세 속도 또는 출력"/><TextBlock Text="속도는 원문 mph 경계로 환산해 대응해요. 평지·짐 없음, 러닝머신은 일반 장비의 경사 0% 걷기만 지원해요. 맞는 조건이 없으면 계산하지 않아요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel>
                </StackPanel>
                <TextBlock x:Name="EnergyPreview" TextWrapping="Wrap" Foreground="{DynamicResource Ink}" Margin="0,8,0,0"/>
                <TextBlock x:Name="EnergyBasis" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
              </StackPanel></Border>
              <TextBlock Text="메모 · 선택" Foreground="{DynamicResource Muted}"/><TextBox x:Name="WorkoutNote" AcceptsReturn="True" TextWrapping="Wrap" Height="64" VerticalScrollBarVisibility="Auto" MaxLength="2000" TextChanged="Editor_Changed" AutomationProperties.Name="운동 메모"/>
              <TextBlock Text="예상 kcal은 휴식 대사를 포함한 해당 시간의 총 소모량 추정이에요. 세트·거리 입력은 다음 단계에 추가해요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <Button x:Name="CancelWorkoutEdit" Content="운동 입력 취소" Click="CancelWorkoutEdit_Click"/>
            </StackPanel></ScrollViewer>
            <ScrollViewer x:Name="ReviewPane" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,18,18,4">
              <TextBlock Text="하루 회고" Margin="0,0,0,8"/>
              <TextBlock Text="모두 선택 입력이에요. 한 칸만 적어도 괜찮아요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock x:Name="ReviewState" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
              <TextBlock Text="잘한 점"/><TextBox x:Name="ReviewGood" AcceptsReturn="True" TextWrapping="Wrap" Height="104" MaxLength="2000" VerticalScrollBarVisibility="Auto" TextChanged="Review_Changed" AutomationProperties.Name="회고 잘한 점"/>
              <TextBlock Text="아쉬운 점"/><TextBox x:Name="ReviewDifficult" AcceptsReturn="True" TextWrapping="Wrap" Height="104" MaxLength="2000" VerticalScrollBarVisibility="Auto" TextChanged="Review_Changed" AutomationProperties.Name="회고 아쉬운 점"/>
              <TextBlock Text="다음 행동"/><TextBox x:Name="ReviewNextAction" AcceptsReturn="True" TextWrapping="Wrap" Height="104" MaxLength="2000" VerticalScrollBarVisibility="Auto" TextChanged="Review_Changed" AutomationProperties.Name="회고 다음 행동"/>
              <TextBlock Text="각 칸은 2,000자까지 저장해요. 저장한 회고를 전부 비우면 저장할 때 삭제 여부를 확인해요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel></ScrollViewer>
            <StackPanel Grid.Row="3" Margin="18,8,18,16"><TextBlock x:Name="SaveStatus" Text="선택한 날짜의 기록" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><Button x:Name="SaveButton" Content="저장" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" ToolTip="계획·운동·회고의 변경을 함께 저장해요." Click="Save_Click" Margin="0" Padding="12,9"/></StackPanel>
          </Grid>
        </Border>
        <ScrollViewer x:Name="StatisticsPane" Grid.ColumnSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Margin="20,8,20,16"><StackPanel x:Name="StatisticsContent" MinWidth="700" Margin="0,0,12,8"/></ScrollViewer>
      </Grid>
      <Grid Grid.Row="2" x:Name="Footer" Margin="20,0,20,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="기록을 준비하고 있어요." ToolTip="X는 트레이로 숨겨요. 앱을 다시 실행하면 숨긴 창이 열려요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="완전히 종료" Padding="6,2" Margin="8,0,0,0" Background="Transparent" Click="Exit_Click"/>
      </Grid>
      <Grid x:Name="ReminderOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="20" Background="#55000000">
        <Border x:Name="ReminderCard" Width="520" MaxHeight="540" Background="{DynamicResource Paper}" CornerRadius="14" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="오늘 아직 남은 할 일이 있어요" FontSize="{x:Static ui:UiTypography.Subheading}" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center"/><Button x:Name="ReminderClose" Grid.Column="1" Content="×" ToolTip="할 일 알림 닫기" Click="DismissReminder_Click" Padding="8,2"/></Grid>
            <StackPanel Grid.Row="1" Margin="0,10,0,12"><TextBlock x:Name="ReminderHeading" TextWrapping="Wrap"/><TextBlock Text="저장된 계획 기준이에요. 닫아도 계획은 그대로 남아요." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
            <ScrollViewer x:Name="ReminderViewport" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ReminderList"/></ScrollViewer>
            <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="ReminderDismiss" Content="닫기" Click="DismissReminder_Click"/><Button Content="오늘의 계획 열기" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Click="OpenReminderDate_Click"/></WrapPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
