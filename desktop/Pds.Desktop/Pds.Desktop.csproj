<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- WPF owns the window and manifest DPI settings; WinForms supplies only tray/color dialogs. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Pds.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Pds.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Pds.Core/Pds.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts/GowunDodum-Regular.ttf" />
    <Resource Include="Assets/Pds.ico" />
    <None Update="Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
